{
  "name": "vizlab-dashboard-gallery",
  "version": "1.1.0",
  "private": true,
  "description": "Interactive digital twin dashboards built with Three.js, shaders and D3",
  "license": "MIT",
  "repository": "github:yinweinidongle/screen-picture-demo",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/server.mjs",
    "build": "node scripts/tasks.mjs build",
    "build:web": "node scripts/tasks.mjs build --mode web",
    "build:standalone": "node scripts/tasks.mjs build --mode standalone",
    "build:wind": "node scripts/tasks.mjs build --target wind",
    "build:factory": "node scripts/tasks.mjs build --target factory",
    "build:population": "node scripts/tasks.mjs build --target population",
    "build:inspection": "node scripts/tasks.mjs build --target inspection",
    "build:home": "node scripts/tasks.mjs build --target home",
    "check": "node scripts/check.mjs",
    "test": "node scripts/tasks.mjs test && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src config scripts tests docs *.md .github package.json playwright.config.mjs .prettierrc.json && node scripts/tasks.mjs format-python",
    "format:check": "prettier --check src config scripts tests docs *.md .github package.json playwright.config.mjs .prettierrc.json && node scripts/tasks.mjs format-python --check",
    "new:screen": "node scripts/new-screen.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
